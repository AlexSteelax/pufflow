<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear /> 
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
        <add key="GitHub" value="https://nuget.pkg.github.com/AlexSteelax/index.json" />
    </packageSources>
    <packageSourceMapping>
        <packageSource key="GitHub">
            <package pattern="Steelax.*" />
        </packageSource>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
</configuration>