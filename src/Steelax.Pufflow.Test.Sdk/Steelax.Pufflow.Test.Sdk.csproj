<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Steelax.Pufflow.Sdk.Test</RootNamespace>
        <IsPackable>true</IsPackable>

        <!-- NuGet package metadata (project-specific; shared metadata lives in Directory.Build.props) -->
        <PackageId>Steelax.Pufflow.Test.Sdk</PackageId>
        <Description>Test SDK (sources and sinks over System.Threading.Channels) for writing tests against Steelax.Pufflow dataflow pipelines.</Description>
        <PackageTags>dataflow;pipeline;poll;push;test;sdk;testing;stream;pufflow</PackageTags>
        <PackageReleaseNotes>Initial pre-release.</PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Steelax.Pufflow.Generator\Steelax.Pufflow.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
        <ProjectReference Include="..\Steelax.Pufflow\Steelax.Pufflow.csproj"/>
    </ItemGroup>

</Project>
