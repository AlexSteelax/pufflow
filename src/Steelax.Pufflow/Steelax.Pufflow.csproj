<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>true</IsPackable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <!-- NuGet package metadata (project-specific; shared metadata lives in Directory.Build.props) -->
        <PackageId>Steelax.Pufflow</PackageId>
        <Description>A library for building dataflow pipelines based on Poll and Push models and their combinations.</Description>
        <PackageTags>dataflow;pipeline;poll;push;stream;pufflow</PackageTags>
        <PackageReleaseNotes>Initial pre-release.</PackageReleaseNotes>

        <!-- Documentation -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Steelax.Pufflow.Tests" />
    </ItemGroup>

    <!-- Reference the source generator as a NuGet dependency of this package -->
    <ItemGroup>
        <ProjectReference Include="..\Steelax.Pufflow.Generator\Steelax.Pufflow.Generator.csproj" />
    </ItemGroup>
    
    <ItemGroup>
      <PackageReference Include="JetBrains.Annotations" />
      <PackageReference Include="Steelax.Toolkit.HighPerformance" />
    </ItemGroup>
    
</Project>
