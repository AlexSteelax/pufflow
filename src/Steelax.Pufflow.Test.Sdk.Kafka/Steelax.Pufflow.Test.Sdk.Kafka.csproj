<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Steelax.Pufflow.Sdk.Test.Kafka</RootNamespace>
        <IsPackable>true</IsPackable>

        <!-- NuGet package metadata (project-specific; shared metadata lives in Directory.Build.props) -->
        <PackageId>Steelax.Pufflow.Test.Sdk.Kafka</PackageId>
        <Description>Kafka test SDK (in-memory Kafka test producer/consumer) for writing tests against Steelax.Pufflow Kafka pipelines.</Description>
        <PackageTags>dataflow;pipeline;poll;push;kafka;test;sdk;testing;stream;pufflow</PackageTags>
        <PackageReleaseNotes>Initial pre-release.</PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Steelax.Pufflow.Generator\Steelax.Pufflow.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
        <ProjectReference Include="..\Steelax.Pufflow.Operators.Kafka\Steelax.Pufflow.Operators.Kafka.csproj" />
        <ProjectReference Include="..\Steelax.Pufflow\Steelax.Pufflow.csproj"/>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Confluent.Kafka" />
    </ItemGroup>

</Project>
