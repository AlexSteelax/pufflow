<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>

        <!-- NuGet package metadata (project-specific; shared metadata lives in Directory.Build.props) -->
        <PackageId>Steelax.Pufflow.Operators.Kafka</PackageId>
        <Description>Kafka integration (Consumer source with watermark progress tracking) for Steelax.Pufflow dataflow pipelines.</Description>
        <PackageTags>dataflow;pipeline;poll;push;kafka;stream;pufflow</PackageTags>
        <PackageReleaseNotes>Initial pre-release.</PackageReleaseNotes>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <IsAotCompatible>true</IsAotCompatible>
        <IsTrimmable>true</IsTrimmable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Confluent.Kafka" />
        <PackageReference Include="JetBrains.Annotations" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Steelax.Pufflow.Operators.Kafka.Tests"/>
        <InternalsVisibleTo Include="Steelax.Pufflow.Benchmarks"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Steelax.Pufflow.Generator\Steelax.Pufflow.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
        <ProjectReference Include="..\Steelax.Pufflow.Operators\Steelax.Pufflow.Operators.csproj" />
    </ItemGroup>

</Project>
