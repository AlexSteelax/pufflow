<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>true</IsPackable>

        <!-- NuGet package metadata (project-specific; shared metadata lives in Directory.Build.props) -->
        <PackageId>Steelax.Pufflow.Operators</PackageId>
        <Description>Operators (Buffer, Chunk, Timeout, Warm, ...) for Steelax.Pufflow dataflow pipelines.</Description>
        <PackageTags>dataflow;pipeline;poll;push;operators;stream;pufflow</PackageTags>
        <PackageReleaseNotes>Initial pre-release.</PackageReleaseNotes>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Steelax.Pufflow.Generator\Steelax.Pufflow.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
        <ProjectReference Include="..\Steelax.Pufflow\Steelax.Pufflow.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Steelax.Pufflow.Operators.Tests"/>
        <InternalsVisibleTo Include="Steelax.Pufflow.Operators.Kafka"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Steelax.Toolkit.HighPerformance"/>
        <PackageReference Include="Unio"/>
    </ItemGroup>

</Project>
