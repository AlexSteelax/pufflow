<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>12</LangVersion>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <IsPackable>true</IsPackable>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IsRoslynComponent>true</IsRoslynComponent>
        <NoWarn>$(NoWarn);NU5128</NoWarn>

        <!-- NuGet package metadata (project-specific; shared metadata lives in Directory.Build.props) -->
        <PackageId>Steelax.Pufflow.Generator</PackageId>
        <Description>Source generator for Steelax.Pufflow dataflow pipelines. Generates IFlowable implementation from [Flow]-annotated classes.</Description>
        <PackageTags>dataflow;pipeline;poll;push;source-generator;roslyn</PackageTags>
        <PackageReleaseNotes>Initial pre-release.</PackageReleaseNotes>

        <!-- Documentation -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <!-- Enforce custom packaging layouts -->
    <ItemGroup>
        <None Include="$(OutputPath)\$(AssemblyName).dll"
              Pack="true"
              PackagePath="analyzers/dotnet/cs"
              Visible="false"/>
        <!-- Pack the PDB so the NuGet symbols service can validate the analyzer DLL
             (snupkg is otherwise empty because IncludeBuildOutput is disabled) -->
        <None Include="$(OutputPath)\$(AssemblyName).pdb"
              Pack="true"
              PackagePath="analyzers/dotnet/cs"
              Visible="false"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp"/>
    </ItemGroup>

</Project>
